// Reviewer app: one Worker. Hono handles /api, /auth and /mcp; everything else is
// the React SPA from ./dist. Data is the bcintel snapshot that onclappc02 syncs to
// R2 every 5 min (bucket made in seandavi/monode, apps/bioc_reviews).
{
  "name": "bioc-reviews",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Public host; bioc-reviews.seandavi.workers.dev keeps working.
  "routes": [{ "pattern": "reviewer.bioconductor.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/mcp"]
  },
  // Skills are markdown bundled as text (src/skills.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // Workers Logs + traces for the co-review agent (#38); full sampling while experimental.
  "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true } },
  // Per-reviewer limit on co-review requests (each tool-loop resubmit counts).
  "ratelimits": [{ "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // remote: `wrangler dev` reads the real bucket too.
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "data-bioc-reviews", "remote": true }],
  "vars": {
    "REPO": "Bioconductor/BiocContributions",
    // ponytail: one release deadline, edited by redeploy (decision in #12).
    "DEADLINE": "2026-11-18",
    "DEADLINE_LABEL": "Bioconductor 3.24 manifest",
    // Co-review $ per reviewer per rolling 7 days (admins exempt); estimated from tokens.
    "WEEKLY_CAP_USD": "25",
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/55bf7202fe14474e57a300f56a652f64/bioc-reviews"
  }
  // Secrets (wrangler secret put): GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, SESSION_SECRET,
  // AI_GATEWAY_TOKEN (cdsci-cloudflare-ai-gateway-token), optional GITHUB_READ_TOKEN.
}
